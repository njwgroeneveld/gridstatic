{
  "uid": "gridstatic",
  "title": "gridstatic",
  "tags": ["gridstatic"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "templating": { "list": [
    { "name": "datasource", "label": "Data source", "type": "datasource", "query": "prometheus" },
    { "name": "namespace", "type": "query", "hide": 2, "refresh": 2,
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "query": { "query": "label_values(grid_on_hold, namespace)", "refId": "ns" } },
    { "name": "coin", "label": "Grid", "type": "query", "refresh": 2, "multi": true, "includeAll": true,
      "allValue": ".*", "current": { "text": "All", "value": "$__all" },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "query": { "query": "label_values(grid_on_hold{namespace=\"$namespace\"}, coin)", "refId": "coin" } }
  ] },
  "panels": [
    { "id": 1, "type": "row", "title": "Grids", "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 } },
    { "id": 2, "type": "stat", "title": "State",
      "description": "HOLD: no new buys until the position adds up again. The reason is in the log and in /status.",
      "gridPos": { "x": 0, "y": 1, "w": 8, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "refId": "A", "legendFormat": "{{coin}}",
        "expr": "max by (coin) (grid_on_hold{namespace=\"$namespace\", coin=~\"$coin\"})" }],
      "fieldConfig": { "defaults": {
        "mappings": [{ "type": "value", "options": {
          "0": { "text": "trading", "color": "green" }, "1": { "text": "HOLD", "color": "red" } } }] } },
      "options": { "colorMode": "background", "textMode": "value_and_name", "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] } } },
    { "id": 3, "type": "stat", "title": "Net realised P&L",
      "description": "closedPnl minus fees of the grid's fills over the time range, stop-outs included -- from the exchange.",
      "gridPos": { "x": 8, "y": 1, "w": 8, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "refId": "A", "legendFormat": "{{coin}}",
        "expr": "sum by (coin) (increase(grid_realized_gain_usd_total{namespace=\"$namespace\", coin=~\"$coin\"}[$__range]) - increase(grid_realized_loss_usd_total{namespace=\"$namespace\", coin=~\"$coin\"}[$__range]) - increase(grid_fees_usd_total{namespace=\"$namespace\", coin=~\"$coin\"}[$__range]))" }],
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 2, "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "red", "value": null }, { "color": "green", "value": 0 } ] } } },
      "options": { "colorMode": "value", "textMode": "value_and_name", "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] } } },
    { "id": 18, "type": "table", "title": "Capital",
      "description": "As position value, leverage included. Budget: every cell bought (size per line x leverage x cells). In use: the position now x the mark price. The margin it takes is the value divided by the leverage.",
      "gridPos": { "x": 16, "y": 1, "w": 8, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "format": "table", "instant": true,
          "expr": "max by (coin) (grid_position_value_usd{namespace=\"$namespace\", coin=~\"$coin\"})" },
        { "refId": "B", "format": "table", "instant": true,
          "expr": "max by (coin) (grid_budget_usd{namespace=\"$namespace\", coin=~\"$coin\"})" },
        { "refId": "C", "format": "table", "instant": true,
          "expr": "max by (coin) (grid_position_value_usd{namespace=\"$namespace\", coin=~\"$coin\"}) / max by (coin) (grid_budget_usd{namespace=\"$namespace\", coin=~\"$coin\"})" }],
      "transformations": [
        { "id": "merge", "options": {} },
        { "id": "organize", "options": { "excludeByName": { "Time": true },
          "renameByName": { "coin": "Grid", "Value #A": "In use", "Value #B": "Budget", "Value #C": "Used" } } }],
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 0 }, "overrides": [
        { "matcher": { "id": "byName", "options": "Grid" }, "properties": [{ "id": "unit", "value": "string" }] },
        { "matcher": { "id": "byName", "options": "Used" }, "properties": [
          { "id": "unit", "value": "percentunit" }, { "id": "decimals", "value": 0 },
          { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "basic" } },
          { "id": "min", "value": 0 }, { "id": "max", "value": 1 }] }] },
      "options": { "showHeader": true, "cellHeight": "sm" } },
    { "id": 4, "type": "timeseries", "title": "$coin: price and grid",
      "description": "The mark price between the grid's lowest and highest line, and the stop-loss below it.",
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 8 }, "repeat": "coin", "repeatDirection": "h", "maxPerRow": 2,
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "legendFormat": "price", "expr": "max(grid_mark_price{namespace=\"$namespace\", coin=\"$coin\"})" },
        { "refId": "B", "legendFormat": "upper", "expr": "max(grid_upper_bound{namespace=\"$namespace\", coin=\"$coin\"})" },
        { "refId": "C", "legendFormat": "lower", "expr": "max(grid_lower_bound{namespace=\"$namespace\", coin=\"$coin\"})" },
        { "refId": "D", "legendFormat": "stop-loss", "expr": "max(grid_stop_loss_price{namespace=\"$namespace\", coin=\"$coin\"})" }],
      "fieldConfig": { "defaults": { "decimals": 0, "custom": { "lineWidth": 2 } }, "overrides": [
        { "matcher": { "id": "byName", "options": "price" }, "properties": [
          { "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }] },
        { "matcher": { "id": "byRegexp", "options": "upper|lower" }, "properties": [
          { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } },
          { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } }] },
        { "matcher": { "id": "byName", "options": "stop-loss" }, "properties": [
          { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } },
          { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [4, 6] } }] }] } },

    { "id": 5, "type": "row", "title": "Alerts", "gridPos": { "x": 0, "y": 13, "w": 24, "h": 1 } },
    { "id": 6, "type": "state-timeline", "title": "Alerts over time",
      "description": "When each alert was pending (orange: counting down its 'for' time) or firing (red: sent to Alertmanager). The green 'no alerts' row fills the time when none was. GridstaticDown belongs to no single grid.",
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "refId": "A", "legendFormat": "{{alertname}} {{coin}}",
        "expr": "(max by (alertname, coin) (ALERTS{alertname=~\"Gridstatic.*\", namespace=\"$namespace\", coin=~\"$coin|\", alertstate=\"firing\"}) * 2) or max by (alertname, coin) (ALERTS{alertname=~\"Gridstatic.*\", namespace=\"$namespace\", coin=~\"$coin|\", alertstate=\"pending\"}) or on () label_replace(vector(0), \"alertname\", \"no alerts\", \"\", \"\")" }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" },
        "mappings": [{ "type": "value", "options": {
          "0": { "text": "all clear", "color": "green" },
          "1": { "text": "pending", "color": "orange" }, "2": { "text": "firing", "color": "red" } } }] } },
      "options": { "showValue": "never", "mergeValues": true, "legend": { "showLegend": false } } },

    { "id": 7, "type": "row", "title": "Exchange API", "gridPos": { "x": 0, "y": 19, "w": 24, "h": 1 } },
    { "id": 8, "type": "bargauge", "title": "Where the time goes",
      "description": "Seconds per minute spent waiting on Hyperliquid, per request type, measured in the connector. The biggest bar is what makes a round slow.",
      "gridPos": { "x": 0, "y": 20, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "refId": "A", "instant": true, "legendFormat": "{{request}}",
        "expr": "sort_desc(sum by (request) (rate(connector_hl_request_duration_seconds_sum{namespace=\"$namespace\"}[15m])) * 60 > 0)" }],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 1, "min": 0, "color": { "mode": "continuous-BlYlRd" } }, "overrides": [
        { "matcher": { "id": "byName", "options": "frontendOpenOrders" }, "properties": [{ "id": "displayName", "value": "Open orders" }] },
        { "matcher": { "id": "byName", "options": "metaAndAssetCtxs" }, "properties": [{ "id": "displayName", "value": "Mark price" }] },
        { "matcher": { "id": "byName", "options": "clearinghouseState" }, "properties": [{ "id": "displayName", "value": "Position" }] },
        { "matcher": { "id": "byName", "options": "userFillsByTime" }, "properties": [{ "id": "displayName", "value": "Fills" }] },
        { "matcher": { "id": "byName", "options": "orderStatus" }, "properties": [{ "id": "displayName", "value": "Order lookup" }] },
        { "matcher": { "id": "byName", "options": "order" }, "properties": [{ "id": "displayName", "value": "Place order" }] },
        { "matcher": { "id": "byName", "options": "cancel" }, "properties": [{ "id": "displayName", "value": "Cancel order" }] },
        { "matcher": { "id": "byName", "options": "updateLeverage" }, "properties": [{ "id": "displayName", "value": "Set leverage" }] },
        { "matcher": { "id": "byName", "options": "meta" }, "properties": [{ "id": "displayName", "value": "Lot size" }] },
        { "matcher": { "id": "byName", "options": "allMids" }, "properties": [{ "id": "displayName", "value": "Startup check" }] },
        { "matcher": { "id": "byName", "options": "spotClearinghouseState" }, "properties": [{ "id": "displayName", "value": "Spot balance" }] }] },
      "options": { "orientation": "horizontal", "displayMode": "gradient", "namePlacement": "left",
        "reduceOptions": { "calcs": ["lastNotNull"] } } },
    { "id": 9, "type": "timeseries", "title": "Latency p95 per request",
      "description": "95% of the requests of each kind were answered faster than this line. Only requests made in the window are shown.",
      "gridPos": { "x": 8, "y": 20, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "refId": "A", "legendFormat": "{{request}}",
        "expr": "histogram_quantile(0.95, sum by (le, request) (rate(connector_hl_request_duration_seconds_bucket{namespace=\"$namespace\"}[5m]))) > 0" }],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 2 }, "overrides": [
        { "matcher": { "id": "byName", "options": "frontendOpenOrders" }, "properties": [{ "id": "displayName", "value": "Open orders" }] },
        { "matcher": { "id": "byName", "options": "metaAndAssetCtxs" }, "properties": [{ "id": "displayName", "value": "Mark price" }] },
        { "matcher": { "id": "byName", "options": "clearinghouseState" }, "properties": [{ "id": "displayName", "value": "Position" }] },
        { "matcher": { "id": "byName", "options": "userFillsByTime" }, "properties": [{ "id": "displayName", "value": "Fills" }] },
        { "matcher": { "id": "byName", "options": "orderStatus" }, "properties": [{ "id": "displayName", "value": "Order lookup" }] },
        { "matcher": { "id": "byName", "options": "order" }, "properties": [{ "id": "displayName", "value": "Place order" }] },
        { "matcher": { "id": "byName", "options": "cancel" }, "properties": [{ "id": "displayName", "value": "Cancel order" }] },
        { "matcher": { "id": "byName", "options": "updateLeverage" }, "properties": [{ "id": "displayName", "value": "Set leverage" }] },
        { "matcher": { "id": "byName", "options": "meta" }, "properties": [{ "id": "displayName", "value": "Lot size" }] },
        { "matcher": { "id": "byName", "options": "allMids" }, "properties": [{ "id": "displayName", "value": "Startup check" }] },
        { "matcher": { "id": "byName", "options": "spotClearinghouseState" }, "properties": [{ "id": "displayName", "value": "Spot balance" }] }] } },
    { "id": 10, "type": "timeseries", "title": "Failed requests per minute",
      "description": "Every outcome but ok: rejected (answered but refused), rate_limited, http_4xx/5xx, timeout, connection. Empty is good.",
      "gridPos": { "x": 16, "y": 20, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "refId": "A", "legendFormat": "{{request}}",
        "expr": "sum by (request, outcome) (rate(connector_hl_requests_total{namespace=\"$namespace\", outcome!=\"ok\"}[5m])) * 60 > 0" }],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 2, "noValue": "No failed requests" }, "overrides": [
        { "matcher": { "id": "byName", "options": "frontendOpenOrders" }, "properties": [{ "id": "displayName", "value": "Open orders: ${__field.labels.outcome}" }] },
        { "matcher": { "id": "byName", "options": "metaAndAssetCtxs" }, "properties": [{ "id": "displayName", "value": "Mark price: ${__field.labels.outcome}" }] },
        { "matcher": { "id": "byName", "options": "clearinghouseState" }, "properties": [{ "id": "displayName", "value": "Position: ${__field.labels.outcome}" }] },
        { "matcher": { "id": "byName", "options": "userFillsByTime" }, "properties": [{ "id": "displayName", "value": "Fills: ${__field.labels.outcome}" }] },
        { "matcher": { "id": "byName", "options": "orderStatus" }, "properties": [{ "id": "displayName", "value": "Order lookup: ${__field.labels.outcome}" }] },
        { "matcher": { "id": "byName", "options": "order" }, "properties": [{ "id": "displayName", "value": "Place order: ${__field.labels.outcome}" }] },
        { "matcher": { "id": "byName", "options": "cancel" }, "properties": [{ "id": "displayName", "value": "Cancel order: ${__field.labels.outcome}" }] },
        { "matcher": { "id": "byName", "options": "updateLeverage" }, "properties": [{ "id": "displayName", "value": "Set leverage: ${__field.labels.outcome}" }] },
        { "matcher": { "id": "byName", "options": "meta" }, "properties": [{ "id": "displayName", "value": "Lot size: ${__field.labels.outcome}" }] },
        { "matcher": { "id": "byName", "options": "allMids" }, "properties": [{ "id": "displayName", "value": "Startup check: ${__field.labels.outcome}" }] },
        { "matcher": { "id": "byName", "options": "spotClearinghouseState" }, "properties": [{ "id": "displayName", "value": "Spot balance: ${__field.labels.outcome}" }] }] } },

    { "id": 11, "type": "row", "title": "Health", "gridPos": { "x": 0, "y": 28, "w": 24, "h": 1 } },
    { "id": 12, "type": "stat", "title": "Scrape target",
      "description": "Can Prometheus reach grid-static? GridstaticDown fires after 5 minutes without it.",
      "gridPos": { "x": 0, "y": 29, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "refId": "A", "expr": "max(up{namespace=\"$namespace\", job=~\".+-grid-static\"}) or vector(0)" }],
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": {
        "0": { "text": "DOWN", "color": "red" }, "1": { "text": "up", "color": "green" } } }] } },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } } },
    { "id": 13, "type": "stat", "title": "Rounds that completed",
      "description": "Completed rounds / all rounds over the time range: a simple SLO. A round is skipped when the exchange cannot be read.",
      "gridPos": { "x": 6, "y": 29, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "refId": "A",
        "expr": "sum(increase(grid_round_duration_seconds_count{namespace=\"$namespace\"}[$__range])) / (sum(increase(grid_round_duration_seconds_count{namespace=\"$namespace\"}[$__range])) + (sum(increase(grid_errors_total{namespace=\"$namespace\", type=~\"read|round\"}[$__range])) or vector(0)))" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 2, "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "red", "value": null }, { "color": "orange", "value": 0.99 }, { "color": "green", "value": 0.999 } ] } } },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } } },
    { "id": 14, "type": "stat", "title": "Since the last round",
      "description": "A bot can be up and still be stuck. A round runs every 30 seconds.",
      "gridPos": { "x": 12, "y": 29, "w": 12, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "refId": "A", "legendFormat": "{{coin}}",
        "expr": "time() - max by (coin) (grid_last_round_timestamp_seconds{namespace=\"$namespace\", coin=~\"$coin\"})" }],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 0, "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "orange", "value": 120 }, { "color": "red", "value": 300 } ] } } },
      "options": { "colorMode": "value", "textMode": "value_and_name", "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] } } },
    { "id": 15, "type": "timeseries", "title": "CPU per pod",
      "description": "In cores, one pod per service. The dashed line is the limit.",
      "gridPos": { "x": 0, "y": 33, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "legendFormat": "{{container}}",
          "expr": "sum by (container) (rate(container_cpu_usage_seconds_total{namespace=\"$namespace\", container!=\"\", container!=\"POD\"}[5m]))" },
        { "refId": "B", "legendFormat": "limit",
          "expr": "max(kube_pod_container_resource_limits{namespace=\"$namespace\", resource=\"cpu\"})" }],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 3, "min": 0 }, "overrides": [
        { "matcher": { "id": "byName", "options": "limit" }, "properties": [
          { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } },
          { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } }] }] } },
    { "id": 16, "type": "timeseries", "title": "CPU throttling per pod",
      "description": "Share of CPU periods in which the container hit its limit and was made to wait. The average CPU can be far below the limit while short bursts still hit it -- this shows those.",
      "gridPos": { "x": 8, "y": 33, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "refId": "A", "legendFormat": "{{container}}",
        "expr": "sum by (container) (rate(container_cpu_cfs_throttled_periods_total{namespace=\"$namespace\", container!=\"\", container!=\"POD\"}[5m])) / sum by (container) (rate(container_cpu_cfs_periods_total{namespace=\"$namespace\", container!=\"\", container!=\"POD\"}[5m]))" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 1, "min": 0 } } },
    { "id": 17, "type": "timeseries", "title": "Memory per pod",
      "description": "Working set: what the kernel counts against the limit. At the limit (dashed) the container is killed (OOM).",
      "gridPos": { "x": 16, "y": 33, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "legendFormat": "{{container}}",
          "expr": "sum by (container) (container_memory_working_set_bytes{namespace=\"$namespace\", container!=\"\", container!=\"POD\"})" },
        { "refId": "B", "legendFormat": "limit",
          "expr": "max(kube_pod_container_resource_limits{namespace=\"$namespace\", resource=\"memory\"})" }],
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0 }, "overrides": [
        { "matcher": { "id": "byName", "options": "limit" }, "properties": [
          { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } },
          { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } }] }] } }
  ]
}
