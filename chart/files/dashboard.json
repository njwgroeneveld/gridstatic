{
  "uid": "gridstatic",
  "title": "gridstatic",
  "tags": [
    "gridstatic",
    "trading"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "name": "Annotations & Alerts",
        "type": "dashboard",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        }
      },
      {
        "name": "Deploys",
        "enable": true,
        "iconColor": "purple",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "expr": "max by (commit) (grid_build_info{namespace=\"$namespace\"}) and on () (changes(max(process_start_time_seconds{namespace=\"$namespace\", job=~\".+-grid-static\"})[2m:30s]) > 0)",
        "step": "1m",
        "titleFormat": "grid-static started: {{commit}}",
        "textFormat": "",
        "tagKeys": "commit"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "namespace",
        "type": "query",
        "hide": 2,
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(grid_on_hold, namespace)",
          "refId": "namespace"
        },
        "definition": "label_values(grid_on_hold, namespace)",
        "refresh": 2
      },
      {
        "name": "coin",
        "label": "Grid",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(grid_on_hold{namespace=\"$namespace\"}, coin)",
          "refId": "coin"
        },
        "definition": "label_values(grid_on_hold{namespace=\"$namespace\"}, coin)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1,
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Net realised P&L (time range)",
      "description": "closedPnl minus fees of every fill of the grid, stop-outs included -- from the exchange. Fills while the pod was down are missing.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{coin}}",
          "expr": "sum by (coin) (increase(grid_realized_gain_usd_total{namespace=\"$namespace\", coin=~\"$coin\"}[$__range]) - increase(grid_realized_loss_usd_total{namespace=\"$namespace\", coin=~\"$coin\"}[$__range]) - increase(grid_fees_usd_total{namespace=\"$namespace\", coin=~\"$coin\"}[$__range]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Unrealised P&L",
      "description": "(mark price - entry price) x position: what the open position would make or lose if closed now.",
      "gridPos": {
        "x": 5,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{coin}}",
          "expr": "max by (coin) (grid_unrealized_pnl_usd{namespace=\"$namespace\", coin=~\"$coin\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Position value",
      "description": "Position x mark price: how much coin the grid holds, in dollars.",
      "gridPos": {
        "x": 10,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{coin}}",
          "expr": "max by (coin) (grid_position_value_usd{namespace=\"$namespace\", coin=~\"$coin\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Account value",
      "description": "The balance each grid's orders draw on. Hyperliquid keeps one balance per perp dex: BTC trades on the default dex, a HIP-3 market such as xyz:XYZ100 on its own. Grids on the same dex share one balance.",
      "gridPos": {
        "x": 15,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{coin}}",
          "expr": "max by (coin) (grid_account_value_usd{namespace=\"$namespace\", coin=~\"$coin\", coin!=\"\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "State",
      "description": "HOLD: no new buys until the position adds up again. The reason is in the logs, in /status and in the Telegram alert.",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{coin}}",
          "expr": "max by (coin) (grid_on_hold{namespace=\"$namespace\", coin=~\"$coin\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "trading",
                  "color": "green"
                },
                "1": {
                  "text": "HOLD",
                  "color": "red"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Net realised P&L per hour",
      "description": "Set the time range to a day or more: each bar is a whole hour.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "interval": "1h",
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{coin}}",
          "expr": "sum by (coin) (increase(grid_realized_gain_usd_total{namespace=\"$namespace\", coin=~\"$coin\"}[1h]) - increase(grid_realized_loss_usd_total{namespace=\"$namespace\", coin=~\"$coin\"}[1h]) - increase(grid_fees_usd_total{namespace=\"$namespace\", coin=~\"$coin\"}[1h]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Account value",
      "description": "The equity curve, per grid. Grids on the same perp dex share one balance.",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{coin}}",
          "expr": "max by (coin) (grid_account_value_usd{namespace=\"$namespace\", coin=~\"$coin\", coin!=\"\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Unrealised P&L",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{coin}}",
          "expr": "max by (coin) (grid_unrealized_pnl_usd{namespace=\"$namespace\", coin=~\"$coin\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Position value",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{coin}}",
          "expr": "max by (coin) (grid_position_value_usd{namespace=\"$namespace\", coin=~\"$coin\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "custom": {
            "fillOpacity": 10,
            "lineInterpolation": "stepAfter"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 30,
      "type": "row",
      "title": "Price and grid",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 31,
      "type": "bargauge",
      "title": "Where the price is in the grid",
      "description": "0% is the lowest line, 100% the highest. Red: the price is outside the grid -- below it the grid has nothing to buy, above it nothing left to sell.",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{coin}}",
          "expr": "(max by (coin) (grid_mark_price{namespace=\"$namespace\", coin=~\"$coin\"}) - max by (coin) (grid_lower_bound{namespace=\"$namespace\", coin=~\"$coin\"})) / (max by (coin) (grid_upper_bound{namespace=\"$namespace\", coin=~\"$coin\"}) - max by (coin) (grid_lower_bound{namespace=\"$namespace\", coin=~\"$coin\"})) * 100"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "Price and grid: $coin",
      "description": "The mark price between the grid's lowest and highest line, and the stop-loss below it.",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 9
      },
      "repeat": "coin",
      "repeatDirection": "h",
      "maxPerRow": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "price",
          "expr": "max(grid_mark_price{namespace=\"$namespace\", coin=\"$coin\"})"
        },
        {
          "refId": "B",
          "legendFormat": "upper bound",
          "expr": "max(grid_upper_bound{namespace=\"$namespace\", coin=\"$coin\"})"
        },
        {
          "refId": "C",
          "legendFormat": "lower bound",
          "expr": "max(grid_lower_bound{namespace=\"$namespace\", coin=\"$coin\"})"
        },
        {
          "refId": "D",
          "legendFormat": "stop-loss",
          "expr": "max(grid_stop_loss_price{namespace=\"$namespace\", coin=\"$coin\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "price"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "upper bound|lower bound"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "stop-loss"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    4,
                    6
                  ]
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 1
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 40,
      "type": "row",
      "title": "Alerts",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 41,
      "type": "table",
      "title": "Active alerts",
      "description": "From Prometheus: pending is counting down its 'for' time, firing has gone to Alertmanager and Telegram. GridstaticDown belongs to no single grid.",
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 10,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "instant": true,
          "expr": "ALERTS{alertname=~\"Gridstatic.*\", namespace=\"$namespace\", coin=~\"$coin|\"}"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "job": true,
              "namespace": true
            },
            "indexByName": {
              "alertname": 0,
              "coin": 1,
              "alertstate": 2,
              "severity": 3
            },
            "renameByName": {
              "alertname": "Alert",
              "coin": "Grid",
              "alertstate": "State",
              "severity": "Severity"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No active alerts"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "firing": {
                        "color": "red",
                        "text": "firing"
                      },
                      "pending": {
                        "color": "orange",
                        "text": "pending"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 42,
      "type": "state-timeline",
      "title": "Alerts over time",
      "description": "Orange: pending. Red: firing. Empty: all clear.",
      "gridPos": {
        "x": 10,
        "y": 36,
        "w": 14,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{alertname}} {{coin}}",
          "expr": "(max by (alertname, coin) (ALERTS{alertname=~\"Gridstatic.*\", namespace=\"$namespace\", coin=~\"$coin|\", alertstate=\"firing\"}) * 2) or max by (alertname, coin) (ALERTS{alertname=~\"Gridstatic.*\", namespace=\"$namespace\", coin=~\"$coin|\", alertstate=\"pending\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "pending",
                  "color": "orange"
                },
                "2": {
                  "text": "firing",
                  "color": "red"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        }
      }
    },
    {
      "id": 43,
      "type": "state-timeline",
      "title": "Hold",
      "description": "Every hold, also the short ones the GridstaticHold alert leaves out.",
      "gridPos": {
        "x": 0,
        "y": 43,
        "w": 24,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{coin}}",
          "expr": "max by (coin) (grid_on_hold{namespace=\"$namespace\", coin=~\"$coin\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "trading",
                  "color": "green"
                },
                "1": {
                  "text": "HOLD",
                  "color": "red"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
