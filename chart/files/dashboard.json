    {
      "id": 53,
      "type": "timeseries",
      "title": "Latency p95",
      "description": "round: one cycle of one grid -- read orders, position, price and fills from the exchange, decide, place and cancel. Each grid runs its own every 30 seconds. order: placing one order. 95% of them are faster than the line.",
      "gridPos": {
        "x": 16,
        "y": 49,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "round {{coin}}",
          "expr": "histogram_quantile(0.95, sum by (le, coin) (rate(grid_round_duration_seconds_bucket{namespace=\"$namespace\", coin=~\"$coin\", coin!=\"\"}[5m])))"
        },
        {
          "refId": "B",
          "legendFormat": "order {{coin}}",
          "expr": "histogram_quantile(0.95, sum by (le, coin) (rate(grid_order_placement_latency_seconds_bucket{namespace=\"$namespace\", coin=~\"$coin\"}[30m])))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
