{
  "uid": "gridstatic",
  "title": "gridstatic",
  "tags": ["gridstatic", "trading"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": { "from": "now-7d", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource", "label": "Data source", "type": "datasource",
        "query": "prometheus", "current": {}, "hide": 0
      },
      {
        "name": "coin", "label": "Grid", "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": { "query": "label_values(grid_on_hold, coin)", "refId": "coin" },
        "definition": "label_values(grid_on_hold, coin)",
        "refresh": 2, "multi": true, "includeAll": true, "allValue": ".*",
        "current": { "text": "All", "value": "$__all" }, "sort": 1, "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Net realised P&L (time range)",
      "description": "closedPnl minus fees of every fill of the grid, stop-outs included -- from the exchange. Fills while the pod was down are missing.",
      "gridPos": { "x": 0, "y": 0, "w": 5, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{
        "refId": "A", "legendFormat": "{{coin}}",
        "expr": "sum by (coin) (increase(grid_realized_gain_usd_total{coin=~\"$coin\"}[$__range]) - increase(grid_realized_loss_usd_total{coin=~\"$coin\"}[$__range]) - increase(grid_fees_usd_total{coin=~\"$coin\"}[$__range]))"
      }],
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 2,
        "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "red", "value": null }, { "color": "green", "value": 0 } ] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "id": 2, "type": "stat", "title": "Unrealised P&L",
      "gridPos": { "x": 5, "y": 0, "w": 5, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "refId": "A", "legendFormat": "{{coin}}",
        "expr": "max by (coin) (grid_unrealized_pnl_usd{coin=~\"$coin\"})" }],
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 2,
        "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "red", "value": null }, { "color": "green", "value": 0 } ] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "id": 3, "type": "stat", "title": "Position value",
      "gridPos": { "x": 10, "y": 0, "w": 5, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "refId": "A", "legendFormat": "{{coin}}",
        "expr": "max by (coin) (grid_position_value_usd{coin=~\"$coin\"})" }],
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 2,
        "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "id": 4, "type": "stat", "title": "Account value",
      "description": "Per perp dex: a HIP-3 market such as xyz keeps a balance of its own.",
      "gridPos": { "x": 15, "y": 0, "w": 5, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "refId": "A", "legendFormat": "{{dex}}",
        "expr": "max by (dex) (grid_account_value_usd)" }],
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 2,
        "color": { "mode": "fixed", "fixedColor": "text" } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "id": 5, "type": "stat", "title": "State",
      "description": "HOLD: no new buys until the position adds up again. The reason is in the logs, in /status and in the Telegram alert.",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "refId": "A", "legendFormat": "{{coin}}",
        "expr": "max by (coin) (grid_on_hold{coin=~\"$coin\"})" }],
      "fieldConfig": { "defaults": {
        "mappings": [{ "type": "value", "options": {
          "0": { "text": "trading", "color": "green" },
          "1": { "text": "HOLD", "color": "red" } } }],
        "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "id": 6, "type": "timeseries", "title": "Net realised P&L per hour",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "interval": "1h",
      "targets": [{ "refId": "A", "legendFormat": "{{coin}}",
        "expr": "sum by (coin) (increase(grid_realized_gain_usd_total{coin=~\"$coin\"}[1h]) - increase(grid_realized_loss_usd_total{coin=~\"$coin\"}[1h]) - increase(grid_fees_usd_total{coin=~\"$coin\"}[1h]))" }],
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 2,
        "custom": { "drawStyle": "bars", "fillOpacity": 80, "lineWidth": 1 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] },
        "tooltip": { "mode": "multi" } }
    },
    {
      "id": 7, "type": "timeseries", "title": "Account value",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "refId": "A", "legendFormat": "{{dex}}",
        "expr": "max by (dex) (grid_account_value_usd)" }],
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 2,
        "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" } }
    },
    {
      "id": 8, "type": "timeseries", "title": "Unrealised P&L",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "refId": "A", "legendFormat": "{{coin}}",
        "expr": "max by (coin) (grid_unrealized_pnl_usd{coin=~\"$coin\"})" }],
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 2,
        "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" } }
    },
    {
      "id": 9, "type": "timeseries", "title": "Position value",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "refId": "A", "legendFormat": "{{coin}}",
        "expr": "max by (coin) (grid_position_value_usd{coin=~\"$coin\"})" }],
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 2,
        "custom": { "fillOpacity": 10, "lineInterpolation": "stepAfter" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" } }
    },
    {
      "id": 10, "type": "timeseries", "title": "Price inside the grid",
      "description": "Distance to the bounds in %. Below 0: the price is outside the grid.",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "legendFormat": "{{coin}} above lower",
          "expr": "max by (coin) (grid_price_vs_lower_pct{coin=~\"$coin\"})" },
        { "refId": "B", "legendFormat": "{{coin}} below upper",
          "expr": "max by (coin) (grid_price_vs_upper_pct{coin=~\"$coin\"})" }],
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 1,
        "custom": { "thresholdsStyle": { "mode": "line" } },
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "red", "value": null }, { "color": "transparent", "value": 0 } ] } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" } }
    },
    {
      "id": 11, "type": "state-timeline", "title": "Hold",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "refId": "A", "legendFormat": "{{coin}}",
        "expr": "max by (coin) (grid_on_hold{coin=~\"$coin\"})" }],
      "fieldConfig": { "defaults": {
        "mappings": [{ "type": "value", "options": {
          "0": { "text": "trading", "color": "green" },
          "1": { "text": "HOLD", "color": "red" } } }],
        "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] },
      "options": { "showValue": "never", "mergeValues": true, "rowHeight": 0.8,
        "legend": { "showLegend": false } }
    },
    {
      "id": 12, "type": "timeseries", "title": "Fills per hour",
      "gridPos": { "x": 0, "y": 28, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "interval": "1h",
      "targets": [{ "refId": "A", "legendFormat": "{{coin}} {{side}}",
        "expr": "sum by (coin, side) (increase(grid_fills_total{coin=~\"$coin\"}[1h]))" }],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0,
        "custom": { "drawStyle": "bars", "fillOpacity": 80 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" } }
    },
    {
      "id": 13, "type": "timeseries", "title": "Errors per minute",
      "description": "All grids together; the type says where it went wrong.",
      "gridPos": { "x": 8, "y": 28, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "refId": "A", "legendFormat": "{{type}}",
        "expr": "sum by (type) (rate(grid_errors_total[5m])) * 60" }],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 2,
        "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" } }
    },
    {
      "id": 14, "type": "timeseries", "title": "Latency p95",
      "gridPos": { "x": 16, "y": 28, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "legendFormat": "round",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(grid_round_duration_seconds_bucket[5m])))" },
        { "refId": "B", "legendFormat": "order {{coin}}",
          "expr": "histogram_quantile(0.95, sum by (le, coin) (rate(grid_order_placement_latency_seconds_bucket{coin=~\"$coin\"}[30m])))" }],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 2 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" } }
    }
  ]
}
